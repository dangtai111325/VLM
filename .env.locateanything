# Dedicated LocateAnything environment (tracked, contains no secrets)
# NVIDIA's model card currently pins Transformers 4.57.1 for this model.
LOCATEANYTHING_MODEL=nvidia/LocateAnything-3B
LOCATEANYTHING_TRANSFORMERS=4.57.1
LOCATEANYTHING_MODE=hybrid
LOCATEANYTHING_MAX_NEW_TOKENS=2048

# Windows example:
LOCATEANYTHING_PYTHON=.venv-locateanything/Scripts/python.exe
# Linux/WSL example:
# LOCATEANYTHING_PYTHON=.venv-locateanything/bin/python
