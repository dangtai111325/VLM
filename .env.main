# Main benchmark environment (tracked, contains no secrets)
# Install these packages in the Jupyter kernel environment.
TRANSFORMERS_SPEC=transformers>=5.1,<6
ULTRALYTICS_SPEC=ultralytics>=8.4.0
RFDETR_SPEC=rfdetr[plus]>=1.10
DDS_CLOUDAPI_SDK_SPEC=dds-cloudapi-sdk>=0.5.3

GROUNDING_DINO_REPO=IDEA-Research/grounding-dino-base
YOLO_WORLD_WEIGHT=yolov8l-worldv2.pt
YOLOE_WEIGHT=yoloe-26l-seg.pt

# 0 = UI starts with whichever models pass preflight.
# 1 = preserve strict behavior and fail unless every model is ready.
VLM_REQUIRE_ALL_MODELS_READY=0
